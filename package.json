{
  "name": "album-grid-for-suno",
  "version": "1.2.3",
  "private": true,
  "description": "Unofficial Firefox extension for Suno album grid views and compact playback indicators.",
  "license": "MIT",
  "scripts": {
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "build": "web-ext build --source-dir extension --artifacts-dir dist --overwrite-dest",
    "test": "node --test tests/extension.test.cjs tests/release.test.cjs",
    "test:ui": "node tests/browser.test.cjs",
    "start": "web-ext run --source-dir extension"
  },
  "devDependencies": {
    "web-ext": "10.7.0",
    "playwright": "1.61.1"
  }
}
